{
  "manifest_version": 3,
  "name": "PotatoPlus",
  "version": "2.6.0",
  "description": "Potato Overflow! NJU土豆改善工程",
  "icons": {
    "96": "img/logo96.png",
    "128": "img/logo128.png",
    "512": "img/logo512.png",
    "1024": "img/logo1024.png"
  },
  "author": "Limos",
  "action": {
    "default_icon": { "96": "img/logo96.png", "128": "img/logo128.png" },
    "default_title": "PotatoPlus 设置"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "*://xk.nju.edu.cn/*"
      ],
      "css": [
        "css/material-components-web.min.css",
        "css/pjw.css",
        "css/pjw-classlist.css",
        "css/pjw-filter.css",
        "css/pjw-console.css"
      ],
      "js": [
        "js/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://p.nju.edu.cn/*"
      ],
      "css": [
        "css/portal-login.css"
      ],
      "js": [
        "js/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://authserver.nju.edu.cn/*"
      ],
      "js": [
        "js/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://ehallapp.nju.edu.cn/jwapp/sys/wspjyyapp/*"
      ],
      "js": [
        "js/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://ehallapp.nju.edu.cn/jwapp/sys/cjcx/*"
      ],
      "js": [
        "js/inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://ehall.nju.edu.cn/ywtb-portal/*"
      ],
      "js": [
        "js/inject.js",
        "js/ehall/schedule-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "js/*",
        "models/*",
        "css/*",
        "fonts/*"
      ],
      "matches": [
        "*://*.nju.edu.cn/*",
        "*://ehallapp.nju.edu.cn/*",
        "*://ams.nju.edu.cn/*"
      ]
    }
  ],
  "permissions": [
    "nativeMessaging",
    "declarativeNetRequest",
    "storage",
    "scripting"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "lms_chatbot_block",
        "enabled": true,
        "path": "rules/lms.json"
      }
    ]
  },
  "background": {
    "service_worker": "js/background.js"
  },
  "host_permissions": [
    "*://p.nju.edu.cn/*",
    "*://xk.nju.edu.cn/*",
    "*://authserver.nju.edu.cn/*",
    "*://ehallapp.nju.edu.cn/*",
    "*://ehall.nju.edu.cn/*",
    "*://ams.nju.edu.cn/*",
    "*://lms.nju.edu.cn/*",
    "*://potatoplus.zcec.top/*",
    "https://njuclass.zcec.top/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "update_url": "https://github.com/GreenTeodoro839/PotatoPlus/releases/latest/download/updates.json"
    }
  }
}
